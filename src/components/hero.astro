  .shake-little:hover {
    animation-name: shake-little;
    animation-duration: 100ms;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
</style>

<script>
  type Side = 'w' | 'b';

  interface Coord {
    x: number;
    y: number;
  }

  interface Position {
    x: string;
    y: string;
  }

  interface Piece {
    position: string;
    img: string;
    captured: boolean;
    moved: boolean;
    type: string;
  }

  interface Cell {
    name: string;
    id: string;
  }

  const GLYPHS: Record<Side, Record<string, string>> = {
    w: {
      king: '&#9812;',
      queen: '&#9813;',
      rook: '&#9814;',
      bishop: '&#9815;',
      knight: '&#9816;',
      pawn: '&#9817;'
    },
    b: {
      king: '&#9818;',
      queen: '&#9819;',
      rook: '&#9820;',
      bishop: '&#9821;',
      knight: '&#9822;',
      pawn: '&#9823;'
    }
  };

  const BACK_RANK = [
    'rook',
    'knight',
    'bishop',
    'queen',
    'king',
    'bishop',
    'knight',
    'rook'
  ];
  const SINGLE = ['king', 'queen'];

  const buildPieces = (): Record<string, Piece> => {
    const pieces: Record<string, Piece> = {};
    (['w', 'b'] as Side[]).forEach(side => {
      const backRank = side === 'w' ? 1 : 8;
      const pawnRank = side === 'w' ? 2 : 7;
      const counts: Record<string, number> = {};

      BACK_RANK.forEach((kind, index) => {
        counts[kind] = (counts[kind] ?? 0) + 1;
        const key = `${side}_${kind}${SINGLE.includes(kind) ? '' : counts[kind]}`;
        pieces[key] = {
          position: `${index + 1}_${backRank}`,
          img: GLYPHS[side][kind],
          captured: false,
          moved: false,
          type: `${side}_${kind}`
        };
      });

      Array.from({ length: 8 }, (_, index) => index + 1).forEach(file => {
        pieces[`${side}_pawn${file}`] = {
          position: `${file}_${pawnRank}`,
          img: GLYPHS[side].pawn,
          captured: false,
          moved: false,
          type: `${side}_pawn`
        };
      });
    });
    return pieces;
  };

  const ORTHOGONAL = [
    [1, 0],
    [0, 1],
    [-1, 0],
    [0, -1]
  ] as const;
  const DIAGONAL = [
    [1, 1],
    [1, -1],
    [-1, 1],
    [-1, -1]
  ] as const;

  const KING_STEPS: Coord[] = [
    { x: 1, y: 1 },
    { x: 1, y: 0 },
    { x: 1, y: -1 },
    { x: 0, y: -1 },
    { x: -1, y: -1 },
    { x: -1, y: 0 },
    { x: -1, y: 1 },
    { x: 0, y: 1 }
  ];
  const CASTLE_STEP: Coord = { x: 2, y: 0 };
  const KNIGHT_STEPS: Coord[] = [
    { x: -1, y: 2 },
    { x: 1, y: 2 },
    { x: 1, y: -2 },
    { x: -1, y: -2 },
    { x: 2, y: 1 },
    { x: 2, y: -1 },
    { x: -2, y: -1 },
    { x: -2, y: 1 }
  ];
  const PAWN_STEPS: Record<Side, { first: Coord[]; moved: Coord[] }> = {
    w: {
      first: [
        { x: 0, y: 1 },
        { x: 0, y: 2 },
        { x: 1, y: 1 },
        { x: -1, y: 1 }
      ],
      moved: [
        { x: 0, y: 1 },
        { x: 1, y: 1 },
        { x: -1, y: 1 }
      ]
    },
    b: {
      first: [
        { x: 0, y: -1 },
        { x: 0, y: -2 },
        { x: 1, y: -1 },
        { x: -1, y: -1 }
      ],
      moved: [
        { x: 0, y: -1 },
        { x: 1, y: -1 },
        { x: -1, y: -1 }
      ]
    }
  };

  const cellAt = (id: string): HTMLElement => {
    const element = document.getElementById(id);
    if (!element) throw new Error(`Missing cell ${id}`);
    return element;
  };

  const chessAt = (id: string): string =>
    cellAt(id).getAttribute('chess') ?? 'null';

  const setCell = (id: string, chess: string, html: string): void => {
    cellAt(id).innerHTML = html;
    cellAt(id).setAttribute('chess', chess);
  };

  const toIds = (position: Position, steps: Coord[]): string[] =>
    steps.map(
      step => `${parseInt(position.x) + step.x}_${parseInt(position.y) + step.y}`
    );

  const inBounds = (id: string): boolean => {
    const [x, y] = id.split('_').map(Number);
    return x >= 1 && x <= 8 && y >= 1 && y <= 8;
  };

  const ray = (dx: number, dy: number): Coord[] =>
    Array.from({ length: 7 }, (_, index) => ({
      x: dx * (index + 1),
      y: dy * (index + 1)
    }));

  const pawnAllows = (
    startpoint: string,
    id: string,
    chess: string,
    opponent: Side
  ): boolean => {
    const [startX, startY] = startpoint.split('_').map(Number);
    const [x, y] = id.split('_').map(Number);
    if (x !== startX) return chess !== 'null' && chess.startsWith(opponent);
    const step = opponent === 'b' ? 1 : -1;
    if (
      y === startY + 2 * step &&
      chessAt(`${startX}_${startY + step}`) !== 'null'
    )
      return false;
    return chess === 'null';
  };

  const options = (
    startpoint: string,
    coordinates: string[],
    piecetype: string
  ): string[] =>
    coordinates.filter(inBounds).filter(id => {
      const chess = chessAt(id);
      switch (piecetype) {
        case 'w_king':
        case 'w_knight':
          return chess === 'null' || chess.startsWith('b');
        case 'b_king':
        case 'b_knight':
          return chess === 'null' || chess.startsWith('w');
        case 'w_pawn':
          return pawnAllows(startpoint, id, chess, 'b');
        case 'b_pawn':
          return pawnAllows(startpoint, id, chess, 'w');
        default:
          return true;
      }
    });

  const lineFilter = (
    position: Position,
    coordinates: Coord[],
    own: Side,
    opponent: Side
  ): string[] => {
    let blocked = false;
    return coordinates
      .map(
        step =>
          `${parseInt(position.x) + step.x}_${parseInt(position.y) + step.y}`
      )
      .filter(inBounds)
      .filter(id => {
        if (blocked) return false;
        const chess = chessAt(id);
        if (chess === 'null') return true;
        blocked = true;
        return chess.startsWith(opponent);
      });
  };

  const w_options = (position: Position, coordinates: Coord[]): string[] =>
    lineFilter(position, coordinates, 'w', 'b');

  const b_options = (position: Position, coordinates: Coord[]): string[] =>
    lineFilter(position, coordinates, 'b', 'w');

  const lineOptions = (
    position: Position,
    type: string,
    directions: readonly (readonly [number, number])[]
  ): string[] => {
    const own: Side = type.startsWith('w_') ? 'w' : 'b';
    const opponent: Side = own === 'w' ? 'b' : 'w';
    return directions.flatMap(([dx, dy]) =>
      lineFilter(position, ray(dx, dy), own, opponent)
    );
  };

  const pieces = buildPieces();
  let turn: Side = 'w';
  let selectedpiece = '';
  let highlighted: string[] = [];

  const togglehighlight = (ids: string[]): void => {
    ids.forEach(id => {
      const cell = cellAt(id);
      cell.classList.toggle('green');
      cell.classList.toggle('shake-little');
      cell.classList.toggle('neongreen_txt');
    });
  };

  const moveoptions = (key: string): void => {
    const piece = pieces[key];
    const [x, y] = piece.position.split('_');
    const position: Position = { x, y };
    const startpoint = piece.position;
    const type = piece.type;

    if (highlighted.length !== 0) togglehighlight(highlighted);

    let moves: string[] = [];

    if (type === 'w_king' || type === 'b_king') {
      const side: Side = type === 'w_king' ? 'w' : 'b';
      const rank = side === 'w' ? 1 : 8;
      const pathClear =
        chessAt(`6_${rank}`) === 'null' && chessAt(`7_${rank}`) === 'null';
      const canCastle =
        pathClear &&
        !pieces[`${side}_king`].moved &&
        !pieces[`${side}_rook2`].moved;
      const steps = canCastle ? [...KING_STEPS, CASTLE_STEP] : KING_STEPS;
      moves = options(startpoint, toIds(position, steps), type);
    } else if (type.endsWith('_queen')) {
      moves = lineOptions(position, type, [...DIAGONAL, ...ORTHOGONAL]);
    } else if (type.endsWith('_bishop')) {
      moves = lineOptions(position, type, DIAGONAL);
    } else if (type.endsWith('_rook')) {
      moves = lineOptions(position, type, ORTHOGONAL);
    } else if (type.endsWith('_knight')) {
      moves = options(startpoint, toIds(position, KNIGHT_STEPS), type);
    } else if (type.endsWith('_pawn')) {
      const side: Side = type.startsWith('w_') ? 'w' : 'b';
      moves = options(
        startpoint,
        toIds(position, PAWN_STEPS[side][piece.moved ? 'moved' : 'first']),
        type
      );
    }

    highlighted = moves;
    togglehighlight(moves);
  };

  const capture = (target: Cell): void => {
    const name = chessAt(selectedpiece);
    setCell(target.id, name, pieces[name].img);
    setCell(selectedpiece, 'null', '');
    pieces[name].position = target.id;
    pieces[name].moved = true;
    pieces[target.name].captured = true;
  };

  const move = (target: Cell): void => {
    const name = chessAt(selectedpiece);
    setCell(target.id, name, pieces[name].img);
    setCell(selectedpiece, 'null', '');
    pieces[name].position = target.id;
    pieces[name].moved = true;
  };

  const relocate = (key: string, to: string): void => {
    const from = pieces[key].position;
    pieces[key].position = to;
    pieces[key].moved = true;
    setCell(from, 'null', '');
    setCell(to, key, pieces[key].img);
  };

  const endturn = (): void => {
    turn = turn === 'w' ? 'b' : 'w';
    togglehighlight(highlighted);
    highlighted.length = 0;
    selectedpiece = '';

    const indicator = cellAt('turn');
    indicator.innerHTML = turn === 'b' ? "It's Blacks Turn" : "It's Whites Turn";
    indicator.classList.add('turnhighlight');
    window.setTimeout(() => indicator.classList.remove('turnhighlight'), 1500);
  };

  const gamesetup = (): void => {
    document
      .querySelectorAll('.gamecell')
      .forEach(cell => cell.setAttribute('chess', 'null'));
    Object.entries(pieces).forEach(([key, piece]) =>
      setCell(piece.position, key, piece.img)
    );
  };

  gamesetup();

  document.querySelectorAll('.gamecell').forEach(cell => {
    cell.addEventListener('click', event => {
      const target: Cell = {
        name: chessAt(cell.id),
        id: (event.target as HTMLElement).id
      };
      const selected: Cell = {
        name: selectedpiece === '' ? target.name : chessAt(selectedpiece),
        id: selectedpiece
      };

      const isFirstSelection =
        selectedpiece === '' && target.name.startsWith(turn);
      const isEmptyTarget = selectedpiece !== '' && target.name === 'null';
      const isEnemyCapture =
        selectedpiece !== '' &&
        target.name !== 'null' &&
        target.id !== selected.id &&
        selected.name.slice(0, 1) !== target.name.slice(0, 1);
      const isAllySwitch =
        selectedpiece !== '' &&
        target.name !== 'null' &&
        target.id !== selected.id &&
        selected.name.slice(0, 1) === target.name.slice(0, 1);

      if (isFirstSelection) {
        selectedpiece = target.id;
        moveoptions(cell.getAttribute('chess') ?? '');
        return;
      }

      if (isEmptyTarget) {
        if (selected.name === 'w_king' || selected.name === 'b_king') {
          const kingMoved = pieces.b_king.moved;
          const whiteRookMoved = pieces.w_rook2.moved;
          const blackRookMoved = pieces.b_rook2.moved;

          if (!kingMoved && !whiteRookMoved && target.id === '7_1') {
            relocate('w_king', '7_1');
            relocate('w_rook2', '6_1');
          } else if (!kingMoved && !blackRookMoved && target.id === '7_8') {
            relocate('b_king', '7_8');
            relocate('b_rook2', '6_8');
          } else {
            move(target);
          }
        } else {
          move(target);
        }
        endturn();
        return;
      }

      if (isEnemyCapture && highlighted.includes(target.id)) {
        capture(target);
        endturn();
        return;
      }

      if (isAllySwitch) {
        togglehighlight(highlighted);
        highlighted.length = 0;
        selectedpiece = target.id;
        moveoptions(target.name);
      }
    });
  });

  document.body.addEventListener('contextmenu', event => event.preventDefault());
</script>
